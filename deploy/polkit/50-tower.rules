// Lets the unprivileged `tower` user do exactly what the app needs:
// start/restart its own units, and manage NetworkManager connections.
polkit.addRule(function (action, subject) {
  if (subject.user !== "tower") {
    return polkit.Result.NOT_HANDLED;
  }
  if (action.id === "org.freedesktop.systemd1.manage-units") {
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if ((unit === "tower.service" || unit === "tower-rt.service" || unit === "tower-update.service") &&
        (verb === "start" || verb === "restart")) {
      return polkit.Result.YES;
    }
  }
  if (action.id.indexOf("org.freedesktop.NetworkManager.") === 0) {
    return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});
