# Belfry display: Chromium full-screen on the Pi's monitor, showing the wall view.
# Runs under cage, a compositor that shows exactly one app: no desktop, no
# windows, no login screen. Runs as its own unprivileged user, never as
# `tower`, so the browser has none of the app's rights.
[Unit]
Description=Towerboard belfry display (kiosk browser)
After=systemd-user-sessions.service tower.service
Wants=tower.service
# The display takes over the first console.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=tower-kiosk
PAMName=tower-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
UtmpIdentifier=tty1
UtmpMode=user
# Wait for the app, so the screen never shows "can't connect".
ExecStartPre=/bin/sh -c 'until /usr/bin/curl -s -o /dev/null http://localhost/api/health; do sleep 2; done'
TimeoutStartSec=infinity
ExecStart=/usr/bin/cage -s -- /usr/bin/chromium \
    --kiosk --ozone-platform=wayland \
    --noerrdialogs --disable-infobars --no-first-run --disable-session-crashed-bubble \
    --disable-features=Translate --password-store=basic --incognito \
    --check-for-update-interval=31536000 \
    http://localhost/?display=wall
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
